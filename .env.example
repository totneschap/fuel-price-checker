# Optional: only needed for full UK coverage (Sainsbury's, BP, Shell, independents...)
# via the official government Fuel Finder API. Without these, the app still works
# using the free retailer feeds in src/retailers.js.
#
# Get these by registering at:
# https://www.developer.fuel-finder.service.gov.uk/fuel-finder/get-started-ifr/onelogin
# (requires a GOV.UK One Login). Your dashboard will show your actual token URL and
# API base URL - only override FUEL_FINDER_TOKEN_URL / FUEL_FINDER_API_BASE below if
# they differ from the defaults already set in src/fuelFinder.js.

FUEL_FINDER_CLIENT_ID=
FUEL_FINDER_CLIENT_SECRET=
# FUEL_FINDER_TOKEN_URL=
# FUEL_FINDER_API_BASE=

# Optional: needed for the EV charging tab. Free API key, no ID verification -
# sign up at https://openchargemap.org (Profile > API Key) and paste it below.
OCM_API_KEY=

# Optional: needed for "biggest price movers" on /uk-fuel-prices-live. A free Postgres
# database (e.g. Neon or Supabase) works fine - without this, the dashboard still
# works but skips the movers section. Standard Postgres connection string format.
DATABASE_URL=
